# Kopieer NIET naar .env — vul deze waarden in bij Vercel > GoKnoop > Settings > Environment Variables.
# Nooit committen met echte waarden.

ROUTEDATABANK_URL=https://kaarten.routedatabank.nl/geoserver/routedatabank/wfs
ROUTEDATABANK_USER=goknoop
ROUTEDATABANK_PASS=

# Optioneel: beschermt /api/debug/wfs tegen publieke toegang.
# Kies zelf een willekeurige string.
DEBUG_SECRET=
